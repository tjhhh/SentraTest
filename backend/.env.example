NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentra_test?schema=public
JWT_ACCESS_SECRET=replace-with-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-refresh-secret-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
